# FaceTrust Auditor Environment Configuration Template
# Copy this file to .env and set your secrets. DO NOT commit the .env file to git.

# Environment mode: development, testing, production
ENVIRONMENT=development

# Core API secret. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string

# Biometric Encryption Key (32-byte url-safe base64 string for Fernet / AES-128-CBC + HMAC-SHA256)
# You can generate a valid key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIOMETRIC_ENCRYPTION_KEY=cR9q82ftW2RUlofawQkkJXkRwhf1_dGhJ0y5l10Q41I=

# Database connection URL (SQLite with parameterized queries)
DATABASE_URL=sqlite:///./facetrust.db

# Create missing tables on startup (disable once you add migrations)
AUTO_CREATE_TABLES=true

# Storage root directory for encrypted biometrics and uploads
STORAGE_DIR=./data/storage

# ===== Sessions and cookies =====
SESSION_COOKIE_NAME=ft_session
CSRF_COOKIE_NAME=ft_csrf
SESSION_TTL_MINUTES=60
SESSION_IDLE_TIMEOUT_MINUTES=30
# Set to true when served over HTTPS (required in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ===== Passwords and login lockout =====
PASSWORD_MIN_LENGTH=12
BCRYPT_ROUNDS=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ===== Per-IP rate limits (single-process, fixed window) =====
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=3600

# ===== Deployment =====
# The first registered account becomes an administrator (bootstrap only).
BOOTSTRAP_FIRST_USER_ADMIN=true
# Only enable when running behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Comma-separated frontend origins, e.g. http://localhost:5173
CORS_ORIGINS=
